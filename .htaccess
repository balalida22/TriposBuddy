# ── Reverse proxy to gunicorn (TCP) ─────────────────────────────────────────
# Gunicorn listens on 127.0.0.1:5387 (see run.sh).
# .htaccess lives in public_html/TriposBuddy/, so $1 is already the path
# relative to that directory — proxy to http://127.0.0.1:5387/$1 so Flask
# receives the stripped path and routes correctly.
# SCRIPT_NAME is injected by passenger_wsgi.py via FORCE_SCRIPT_NAME env var.

RewriteEngine On

# Let Apache serve existing static files directly (app/static/**)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Proxy everything else to gunicorn
RewriteRule ^(.*)$ http://127.0.0.1:5387/$1 [P,L]

# ── Security ────────────────────────────────────────────────────────────────
Options -Indexes
<FilesMatch "^(\.env.*|.*\.toml|.*\.lock|passenger_wsgi\.py|requirements\.txt)$">
    Require all denied
</FilesMatch>

# ── Phusion Passenger (WSGI) ────────────────────────────────────────────────
# Passenger runs passenger_wsgi.py directly inside Apache — no socket or
# external process manager needed. PassengerBaseURI sets SCRIPT_NAME so
# Flask url_for() generates correct /TriposBuddy-prefixed URLs.

PassengerEnabled On
PassengerAppRoot /home/tz387/public_html/TriposBuddy
PassengerBaseURI /TriposBuddy
PassengerPython /home/tz387/public_html/TriposBuddy/venv/bin/python3

# ── Security ────────────────────────────────────────────────────────────────
Options -Indexes
<FilesMatch "^(\.env.*|.*\.toml|.*\.lock|passenger_wsgi\.py|requirements\.txt)$">
    Require all denied
</FilesMatch>

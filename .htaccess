# ── Reverse proxy to uWSGI (binary protocol) ────────────────────────────────
# mod_proxy_uwsgi IS enabled on SRCF; mod_proxy_http is NOT.
# uWSGI listens on 127.0.0.1:5387 using the uWSGI binary protocol (--socket).
# .htaccess is in public_html/TriposBuddy/ so $1 is path relative to that
# directory — proxy to uwsgi://127.0.0.1:5387/$1 (no /TriposBuddy prefix).
# SCRIPT_NAME is injected by passenger_wsgi.py via FORCE_SCRIPT_NAME in .env.

RewriteEngine On

# Let Apache serve existing static files directly (app/static/**)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Proxy everything else to uWSGI
RewriteRule ^(.*)$ uwsgi://127.0.0.1:5387/$1 [P,L]

# ── Security ────────────────────────────────────────────────────────────────
Options -Indexes
<FilesMatch "^(\.env.*|.*\.toml|.*\.lock|passenger_wsgi\.py|requirements\.txt)$">
    Require all denied
</FilesMatch>

# ── uWSGI proxy via SetHandler ───────────────────────────────────────────────
# RewriteRule [P] doesn't forward uwsgi:// to mod_proxy_uwsgi.
# SetHandler proxy:uwsgi://... invokes mod_proxy_uwsgi directly as the
# content handler for this directory, bypassing RewriteRule entirely.
# uWSGI listens on 127.0.0.1:5387 (see run.sh / systemd service).
# SCRIPT_NAME is injected by passenger_wsgi.py via FORCE_SCRIPT_NAME in .env.

Options -Indexes

# Security: deny access to sensitive files
<FilesMatch "^(\.env.*|.*\.toml|.*\.lock|passenger_wsgi\.py|requirements\.txt)$">
    Require all denied
</FilesMatch>

SetHandler proxy:uwsgi://127.0.0.1:5387

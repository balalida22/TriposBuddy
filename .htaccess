# ── Reverse proxy to gunicorn Unix socket ───────────────────────────────────
# .htaccess lives in public_html/TriposBuddy/, so RewriteRule $1 is already
# the path relative to that directory (e.g. "auth/login", not
# "/TriposBuddy/auth/login"). Proxy to http://localhost/$1 so gunicorn
# receives the stripped path and Flask routes correctly.
# X-Forwarded-Prefix lets ProxyFix set SCRIPT_NAME so url_for() generates
# URLs with the /TriposBuddy prefix.

RewriteEngine On

# Let Apache serve existing static files directly (app/static/**)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Proxy everything else to gunicorn (prefix already stripped by .htaccess context)
RewriteRule ^(.*)$ unix:/home/tz387/public_html/TriposBuddy/web.sock|http://localhost/$1 [P,L]

RequestHeader set X-Forwarded-Prefix "/TriposBuddy"

# ── Security ────────────────────────────────────────────────────────────────
Options -Indexes
<FilesMatch "^(\.env.*|.*\.toml|.*\.lock|passenger_wsgi\.py|requirements\.txt)$">
    Require all denied
</FilesMatch>

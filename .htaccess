# ── Reverse proxy to gunicorn Unix socket ───────────────────────────────────
# Gunicorn binds to web.sock (see run.sh / systemd service).
# .htaccess is in public_html/TriposBuddy/, so $1 is the path relative to
# that directory — proxy to http://localhost/$1 (NOT /TriposBuddy/$1).
# SCRIPT_NAME is injected by passenger_wsgi.py via FORCE_SCRIPT_NAME in .env.

RewriteEngine On

# Let Apache serve existing static files directly (app/static/**)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Proxy everything else to gunicorn via Unix socket
RewriteRule ^(.*)$ unix:/home/tz387/public_html/TriposBuddy/web.sock|http://localhost/$1 [P,L]

# ── Security ────────────────────────────────────────────────────────────────
Options -Indexes
<FilesMatch "^(\.env.*|.*\.toml|.*\.lock|passenger_wsgi\.py|requirements\.txt)$">
    Require all denied
</FilesMatch>

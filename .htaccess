# ── Passenger WSGI ─────────────────────────────────────────────────────────
# Replace tz387 with your CRSID if deploying under a different account.
PassengerEnabled On
PassengerAppRoot /home/tz387/public_html/TriposBuddy
PassengerBaseURI /TriposBuddy
PassengerPython /home/tz387/public_html/TriposBuddy/venv/bin/python3

# ── Static files ────────────────────────────────────────────────────────────
# Let Apache serve files that exist on disk (e.g. app/static/**) directly,
# bypassing Passenger for slightly better performance.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ── Security ────────────────────────────────────────────────────────────────
# Suppress directory listing and block access to dot-files / config files.
Options -Indexes
<FilesMatch "^(\.env.*|.*\.toml|.*\.lock|passenger_wsgi\.py|requirements\.txt)$">
    Require all denied
</FilesMatch>

# ── CGI entry point ──────────────────────────────────────────────────────────
# Apache executes app.cgi directly on the web server — no socket or cross-host
# communication needed. SRCF supports Options +ExecCGI in user .htaccess.
# PATH_INFO is set by Apache; SCRIPT_NAME is overridden by the
# FORCE_SCRIPT_NAME middleware in passenger_wsgi.py.

Options +ExecCGI -Indexes
AddHandler cgi-script .cgi

RewriteEngine On
# Serve files that actually exist on disk directly (none expected here,
# but keeps the rule clean for any future static asset shortcuts)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route everything else through the CGI script
RewriteRule ^(.*)$ app.cgi/$1 [L]

# ── Security ────────────────────────────────────────────────────────────────
<FilesMatch "^(\.env.*|.*\.toml|.*\.lock|passenger_wsgi\.py|requirements\.txt)$">
    Require all denied
</FilesMatch>
